# Hochaufloesende Wappen: Anfrage nach X.gif liefert hd/X.png, wenn vorhanden
# (gilt fuer alle Seiten und fuer gespeicherte Berichte; Quelle: scripts/fetch-crests.php)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} ^(.+)/([A-Za-z0-9]+)\.gif$
    RewriteCond %1/hd/%2.png -f
    RewriteRule ^([A-Za-z0-9]+)\.gif$ hd/$1.png [L]
</IfModule>

# Wappen werden im Admin gepflegt (admin/wappen.html): nur 1 Tag cachen, damit ersetzte Wappen bald sichtbar sind
<IfModule mod_expires.c>
    ExpiresByType image/gif "access plus 1 day"
    ExpiresByType image/png "access plus 1 day"
</IfModule>
